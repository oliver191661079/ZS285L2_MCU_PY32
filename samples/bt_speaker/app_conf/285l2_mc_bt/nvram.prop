#
# APPLICATION PROPERTIES
#

# volume config
TONE_VOLUME=6
TTS_MIN_VOLUME=2
TTS_MAX_VOLUME=16
BTPLAY_VOLUME=6
BTCALL_VOLUME=3
LINEIN_VOLUME=8
LOCALPLAY_VOLUME=8
USOUND_VOLUME=8
MIC_IN_VOLUME=8
I2SRX_IN_VOLUME=8
SPDIF_IN_VOLUME=8
LE_VOLUME=8

# poweroff
AUTO_POWERDOWN=true
MAX_SILIENT_TIME=300000

# low power
LOWPOWER_LEVEL=3600000
NOPOWER_LEVEL=3300000

# bluetooth
# 名称格式：mag table_<BT_MAC>_br / mag table_<BT_MAC>_le（启动时按 MAC 自动生成）
BT_PRE_NAME=mag table_
BT_NAME=mag table_000000000000_br
#BT_MAC=F44EFC00224A
BT_LE_NAME=mag table_000000000000_le
BT_LE_AUDIO=mag table_000000000000_le
#local name
LNAME=mag table_000000000000_br
#broadcast name
BNAME=mag table_000000000000_br
#1 - Broadcast Sink; 2 - Broadcast Source
BMODE=1
BT_TEST_MODE=0
BT_BIG_CH=0x0
BROADCAST_ID=0x112233
#pawr_name
PAWR_NAME=285L_PAWR
#0 - CONTROLER_ROLE_MASTER; 1 - CONTROLER_ROLE_SLAVE
PHONE_CONTROLER_ROLE=0


FM_DEFAULT_FREQ=9100

# end of APPLICATION PROPERTIES
