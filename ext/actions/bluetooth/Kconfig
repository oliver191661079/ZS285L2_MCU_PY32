config BT_AVRCP_GET_ID3
    bool
    prompt "Bt avrcp get ID3 Support"
    depends on BT_MANAGER
    default y
    help
    This option enables Bt avrcp get ID3 .

config BT_AVRCP_ID3_UART_DUMP
    bool
    prompt "Send AVRCP media text (title/artist/album) over UART as binary frames"
    depends on BT_AVRCP_GET_ID3
    default n
    help
      When ID3 element attributes arrive, sends a compact binary frame per field so an
      external MCU can parse without ASCII "ID3" clutter. Frame layout:
        [SYNC][VER][attr_id][len_hi][len_lo][UTF-8 payload...][CRC8][optional LF]
      SYNC = BT_AVRCP_ID3_UART_FRAME_MAGIC (default 0xD3), VER = protocol version byte
      (default 0x01). Length is 16-bit (endian per BT_AVRCP_ID3_UART_LEN_BIG_ENDIAN).
      CRC8 is computed over [VER][attr_id][len_hi][len_lo] and all payload bytes
      (CRC-8 Dallas/Maxim: poly 0x31, init 0; same routine as in bt_manager_avrcp.c).
      attr_id matches AVRCP element id (e.g. 0x01 title, 0x02 artist, 0x03 album).
      Cover art (0x08) is skipped.
      UART is often shared with printk logs — disable verbose traces and consider
      lowering global SYS_LOG / printk elsewhere if you need a quiet wire.
      Note: magic/length are binary bytes — in a text terminal they look like garbled
      characters before readable UTF-8 title text. Enable BT_AVRCP_ID3_UART_TRACE_HEADER
      during bring-up to print id/len as ASCII, or capture with a hex view.

config BT_AVRCP_ID3_UART_TRACE_HEADER
    bool "Print one ASCII line (magic, id, len) before each binary frame"
    depends on BT_AVRCP_ID3_UART_DUMP
    default n
    help
      Emits a line such as: [LYRIC] m=d3 v=01 id=01 len=42 crc=.. (binary frame follows).
      Helps verify framing on UART0 when shared with printk. Disable for production
      or when the peer MCU must parse a purely binary stream without text lines.

config BT_AVRCP_ID3_UART_FRAME_MAGIC
    hex "First byte of each lyrics UART frame (SYNC)"
    depends on BT_AVRCP_ID3_UART_DUMP
    default 0xD3
    help
      First sync byte (default 0xD3). Second byte is VER (protocol version).

config BT_AVRCP_ID3_UART_FRAME_VER
    hex "Second header byte (protocol version)"
    depends on BT_AVRCP_ID3_UART_DUMP
    default 0x01
    help
      Receiver checks this after SYNC; bump when changing header or CRC algorithm.

config BT_AVRCP_ID3_UART_LEN_BIG_ENDIAN
    bool "16-bit payload length is big-endian"
    depends on BT_AVRCP_ID3_UART_DUMP
    default y
    help
      If n, length is little-endian.

config BT_AVRCP_ID3_UART_APPEND_LF
    bool "Append 0x0A after payload"
    depends on BT_AVRCP_ID3_UART_DUMP
    default n
    help
      Helps naive line-based readers; pure binary parsers should leave this off.

config BT_AVRCP_ID3_UART_VERBOSE
    bool "Verbose printk traces on lyrics UART path"
    depends on BT_AVRCP_ID3_UART_DUMP
    default n

config BT_AVRCP_ID3_UART_SUPPRESS_ID3_SYSLOG
    bool "Suppress SYS_LOG on ID3 UART path (shared UART0 stays binary-only)"
    depends on BT_AVRCP_ID3_UART_DUMP
    default y
    help
      When y, omits "avrcp id3 info" and per-field "id3 N ..." SYS_LOG lines so only
      binary frames (and any other unrelated printk) appear on the console UART.

choice BT_AVRCP_ID3_UART_OUT_MODE
    prompt "AVRCP ID3 UART transmit implementation"
    depends on BT_AVRCP_ID3_UART_DUMP
    default BT_AVRCP_ID3_UART_OUT_CONSOLE if UART_CONSOLE
    default BT_AVRCP_ID3_UART_OUT_POLL

config BT_AVRCP_ID3_UART_OUT_CONSOLE
    bool "Send ID3 via printk (same TX path as logs; required if console UART uses DMA)"
    depends on UART_CONSOLE

config BT_AVRCP_ID3_UART_OUT_POLL
    bool "uart_poll_out on a named UART device"

endchoice

config BT_AVRCP_ID3_UART_POLL_DEV_NAME
    string "UART device name for poll_out ID3 dump"
    depends on BT_AVRCP_ID3_UART_DUMP
    depends on BT_AVRCP_ID3_UART_OUT_POLL
    default "UART_1"
    help
      Must match an enabled driver instance (e.g. CONFIG_UART_ACTS_PORT_0_NAME).

config BT_MANAGER_UART_RX
    bool
    prompt "Bt manager UART RX thread (line-oriented)"
    depends on SERIAL
    depends on UART_INTERRUPT_DRIVEN
    default n
    help
      IRQ-driven RX (uart_fifo_read in ISR) into a ring buffer; a thread assembles
      lines and calls bt_manager_uart_rx_line_hook(). Requires interrupt-mode UART.
      Do not share the same UART with shell/console RX unless console RX is disabled.

config BT_MANAGER_UART_RX_DEV_NAME
    string "UART device name for RX thread"
    depends on BT_MANAGER_UART_RX
    default "UART_0"
    help
      Must match device_get_binding() name (e.g. CONFIG_UART_ACTS_PORT_0_NAME is usually UART_0).
      If this is the same UART as the console, only one subsystem can own uart_irq_callback_set —
      avoid shell/console RX on that port or use a second UART for RX.

config BT_MANAGER_UART_RX_RING_SIZE
    int "ISR ring buffer size (bytes)"
    depends on BT_MANAGER_UART_RX
    default 512

config BT_MANAGER_UART_RX_PRIO
    int "Preemptible priority for RX thread (higher number = lower urgency)"
    depends on BT_MANAGER_UART_RX
    default 14
    help
      Range is 0 .. CONFIG_NUM_PREEMPT_PRIORITIES-1 on Zephyr. Avoid low numbers
      reserved for Bluetooth/audio (they preempt too aggressively).

config BT_MANAGER_UART_RX_STACK_SIZE
    int "Stack size (bytes) for UART RX k_thread (full usable stack; k_thread is separate)"
    depends on BT_MANAGER_UART_RX
    default 2048

config BT_MANAGER_UART_RX_LINE_MAX
    int "Maximum bytes per received line (excl. NUL)"
    depends on BT_MANAGER_UART_RX
    default 128

choice BT_MANAGER_UART_RX_PROTO
    prompt "UART RX protocol on CONFIG_BT_MANAGER_UART_RX_DEV_NAME"
    depends on BT_MANAGER_UART_RX
    default BT_MANAGER_UART_RX_PROTO_LINE

config BT_MANAGER_UART_RX_PROTO_LINE
    bool "Line mode (CR/LF terminated ASCII, bt_manager_uart_rx_line_hook)"
    help
      One text line per command; see bt_manager_uart_rx_line_hook() in application.

config BT_MANAGER_UART_RX_PROTO_BINARY_CMD
    bool "Binary command frames (D3 sync + CRC8, media keys)"
    help
      Wire format per byte:
        [0] SYNC = 0xD3
        [1] VER  = CONFIG_BT_MANAGER_UART_RX_BIN_VER (default 0x02)
        [2][3] LEN = payload length, big-endian (0..CONFIG_BT_MANAGER_UART_RX_BIN_MAX_PAYLOAD)
        [4 .. 3+LEN] payload (e.g. 0xD2 0x00 = previous track)
        [4+LEN] CRC8 Dallas/Maxim over [VER][LEN_H][LEN_L] + each payload byte
      On success calls bt_manager_uart_rx_binary_dispatch(payload, len); default weak
      maps 0xD2 0x00 previous, 0xD2 0x01 next, 0xD2 0x02 pause, 0xD2 0x03 play,
      0xD2 0x04 play/pause toggle, 0xD2 0x05 volume up, 0xD2 0x06 volume down,
      0xD2 0x07 audio effect (DAE) toggle, 0xD2 0x08 answer call,
      0xD2 0x09 hang up / reject call.

endchoice

config BT_MANAGER_UART_RX_BIN_VER
    hex "Binary frame version byte (after 0xD3 SYNC)"
    depends on BT_MANAGER_UART_RX_PROTO_BINARY_CMD
    default 0x02

config BT_MANAGER_UART_RX_BIN_MAX_PAYLOAD
    int "Max payload bytes in one binary UART command frame"
    depends on BT_MANAGER_UART_RX_PROTO_BINARY_CMD
    default 32


